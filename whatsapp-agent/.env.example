# Claude (console.anthropic.com > API keys)
ANTHROPIC_API_KEY=

# Twilio (console.twilio.com > Account info)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The bot's WhatsApp number (sandbox: whatsapp:+14155238886)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Exact URL configured in Twilio, e.g. https://<app>.up.railway.app/whatsapp
TWILIO_WEBHOOK_URL=
# Comma-separated numbers allowed to add deals
ALLOWED_SENDERS=+31612345678

# Microsoft Entra app registration (Graph application permission Files.ReadWrite.All or Sites.Selected)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# The workbook: a sharing link, or EXCEL_DRIVE_ID + EXCEL_ITEM_ID
EXCEL_SHARE_URL=
EXCEL_DRIVE_ID=
EXCEL_ITEM_ID=
# Table name inside the workbook (default: first table)
EXCEL_TABLE=
# Optional: header -> field for headers the agent doesn't recognise, e.g.
# {"Klant":"tenant","Makelaar huurder":"tenant_broker"}
# Fields: tenant building address city size_sqm post_date transaction_date
#         tenant_broker leasing_brokers lease_type notes sender added_at
COLUMN_MAP=
